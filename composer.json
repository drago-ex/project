{
	"name": "drago-ex/project",
	"description": "The basis for new projects on Drago Extension.",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"nette/robot-loader": "^4.1",
		"nette/assets": "^1.0",
		"latte/latte": "^3.1",
		"tracy/tracy": "^2.11",
		"drago-ex/bootstrap": "^2.0",
		"drago-ex/project-docker": "^1.0",
		"drago-ex/project-front": "^3.0"
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"extra": {
		"drago-tools": {
			"vendor-names": "drago-ex",
			"allow-library-install": true
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install",
			"drago-clean"
		]
	}
}
