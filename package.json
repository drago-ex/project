{
	"type": "module",
	"dependencies": {
		"bootstrap": "^5.3.8",
		"live-form-validation": "^1.10.1",
		"naja": "^3.3.3",
		"nette-forms": "^3.5.3"
	},
	"devDependencies": {
		"@nette/vite-plugin": "^1.1.0",
		"@types/node": "^25.0.3",
		"fast-glob": "^3.3.3",
		"ncp": "^2.0.0",
		"sass": "^1.97.1",
		"vite": "^8.2.0"
	},
	"scripts": {
		"docker:build": "docker compose build --no-cache",
		"docker:dev": "docker compose up -d --build && docker compose watch --no-up",
		"docker:production": "docker compose --env-file docker/.env.production up -d --build",
		"docker:down": "docker compose down --remove-orphans",
		"vite:dev": "vite",
		"vite:build": "vite build",
		"npm-loader": "node npm-loader.js",
		"postinstall": "npm run npm-loader"
	},
	"allowScripts": {
		"@parcel/watcher": true,
		"vendor/drago-ex/*": true
	}
}
