#!/usr/bin/env php
<?php declare(strict_types=1);

/**
 * Sets up the project by the installed packages: collects the Assets sections of their READMEs into
 * .drago-project/assets.md, runs their migrations (checks drago-ex/migration and the database connection of
 * local/db.neon, adds the console configuration of the migrations when the project has none), then asks for
 * the administrator (project-auth) and the website name (project-settings) while they are missing.
 */

const ConsoleConfig = 'app/Core/Console/console.neon';
const DbConfig = 'local/db.neon';
const AssetsFile = '.drago-project/assets.md';

$root = getcwd();
$green = "\033[32m";
$blue = "\033[34m";
$yellow = "\033[33m";
$red = "\033[31m";
$reset = "\033[0m";

if (in_array($argv[1] ?? '', ['-h', '--help'], true)) {
	echo <<<'USAGE'
		Set up the project by the installed packages: assets.md, migrations, administrator, website name.

		Usage:
		  php bin/project-setup

		Run it in the project root after composer install; the database connection is read from local/db.neon.

		USAGE;
	exit(0);
}

if ($root === false || !is_file($root . '/vendor/autoload.php')) {
	fwrite(STDERR, "{$red}ERROR: vendor/ not found, run composer install in the project root first.{$reset}\n");
	exit(1);
}

require $root . '/vendor/autoload.php';

// the assets of the installed packages in one file, from the "## Assets" sections of their READMEs
$assets = [];
foreach (Composer\InstalledVersions::getInstalledPackages() as $name) {
	$path = Composer\InstalledVersions::getInstallPath($name);
	if (!str_starts_with($name, 'drago-ex/') || $path === null || realpath($path) === realpath($root)) {
		continue;
	}

	$readme = (string) @file_get_contents($path . '/readme.md'); // @ a package may have no readme
	if (preg_match('~^## Assets\R(.*?)(?=^## |\z)~ms', str_replace("\r\n", "\n", $readme), $m)) {
		$assets[$name] = trim($m[1]);
	}
}

if ($assets !== []) {
	ksort($assets);
	$content = "# Assets of the installed packages\n\n"
		. "Written by bin/project-setup from the Assets sections of the package READMEs. Add what the project uses to\n"
		. "`assets/admin.js`, `admin.scss`, `front.js` and `front.scss`; the file is written again on every run.\n";
	foreach ($assets as $name => $section) {
		$content .= "\n## {$name}\n\n{$section}\n";
	}

	@mkdir(dirname($root . '/' . AssetsFile), 0o777, true); // @ the directory may exist
	file_put_contents($root . '/' . AssetsFile, $content);
	echo "{$green}OK " . AssetsFile . ': the assets of ' . implode(', ', array_keys($assets)) . "{$reset}\n";
}

// 1. the package that runs the migrations
if (!Composer\InstalledVersions::isInstalled('drago-ex/migration')) {
	echo "{$yellow}drago-ex/migration is not installed, so no migrations can run. Install it: composer require drago-ex/migration{$reset}\n";
	exit(0);
}

// 2. the packages with migrations, in the order drago-ex/migration runs them
$migrations = Drago\Migration\MigrationFiles::forProject($root);
if ($migrations === []) {
	echo "{$green}Nothing to migrate: no installed package has migrations.{$reset}\n";
	exit(0);
}

$packages = array_unique(array_map(
	static fn(array $migration): string => $migration['package'] === 'core' ? 'the project' : $migration['package'],
	$migrations,
));
echo "{$blue}INFO Migrations of " . implode(', ', $packages) . "{$reset}\n";

// 3. the database connection of local/db.neon
if (!is_file($root . '/' . DbConfig)) {
	fwrite(STDERR, "{$red}ERROR: " . DbConfig . " not found, it holds the database connection.{$reset}\n");
	exit(1);
}

$dbConfig = Nette\Neon\Neon::decodeFile($root . '/' . DbConfig)['dibi'] ?? null;
if (!is_array($dbConfig)) {
	fwrite(STDERR, "{$red}ERROR: " . DbConfig . " has no dibi section with the database connection.{$reset}\n");
	exit(1);
}

try {
	$db = new Dibi\Connection($dbConfig);
	$db->query('SELECT 1');
	echo "{$green}OK Database connection of " . DbConfig . "{$reset}\n";
} catch (Throwable $e) {
	fwrite(STDERR, "{$red}ERROR: The database connection of " . DbConfig . " is not available: {$e->getMessage()}{$reset}\n");
	exit(1);
}

// 4. the console configuration of the migrations, unless a configuration of the project registers it already
if (findMigrationConfig($root . '/app') === null) {
	@mkdir(dirname($root . '/' . ConsoleConfig), 0o777, true); // @ the directory may exist
	file_put_contents($root . '/' . ConsoleConfig, <<<'NEON'
		# Console commands of the migrations (vendor/bin/migration), written by bin/project-setup.
		extensions:
			migration: Drago\Migration\DI\MigrationExtension(%consoleMode%)
			console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)


		console:
			name: Symfony Console
			version: '1.0'

		NEON);

	// the console runs in production mode, which keeps the found configuration files and the container in the cache
	foreach (['_config.search', 'nette.configurator'] as $cache) {
		deleteDir($root . '/temp/cache/' . $cache);
	}

	echo "{$green}OK " . ConsoleConfig . " created{$reset}\n";
}

// 5. the migrations themselves
echo "{$blue}INFO php vendor/bin/migration db:migrate --packages{$reset}\n";
passthru('php vendor/bin/migration db:migrate --packages', $exitCode);
if ($exitCode !== 0) {
	exit($exitCode);
}

// 6. the administrator account of project-auth, while there is none
if (Composer\InstalledVersions::isInstalled('drago-ex/project-auth')) {
	$admins = (int) $db->query('SELECT COUNT(*) FROM [user_roles] WHERE [role] = %s', 'admin')->fetchSingle();
	if ($admins > 0) {
		echo "{$green}OK The administrator account exists.{$reset}\n";

	} elseif (!stream_isatty(STDIN)) {
		echo "{$yellow}No administrator account; create one: php vendor/bin/create-user <name> <email> <password> --admin{$reset}\n";

	} else {
		echo "{$blue}INFO The administrator account (leave the name empty to skip){$reset}\n";
		while (true) {
			$name = ask('Name');
			if ($name === '') {
				echo "{$yellow}Skipped; create it later: php vendor/bin/create-user <name> <email> <password> --admin{$reset}\n";
				break;
			}

			$email = ask('Email');
			$password = askHidden('Password (at least 12 characters)');

			// create-user of project-auth validates the email and the password and prints what is wrong
			$command = 'php vendor/bin/create-user ' . implode(' ', array_map('escapeshellarg', [$name, $email, $password])) . ' --admin';
			passthru($command, $userExitCode);
			if ($userExitCode === 0) {
				break;
			}
		}
	}
}

// 7. the name and the description of the website of project-settings, while they are not set
if (Composer\InstalledVersions::isInstalled('drago-ex/project-settings')) {
	$website = $db->query('SELECT [value] FROM [settings] WHERE [name] = %s', 'website')->fetchSingle();
	if ($website !== null) {
		echo "{$green}OK The website name is set.{$reset}\n";

	} elseif (!stream_isatty(STDIN)) {
		echo "{$yellow}No website name; set it in the administration (Settings).{$reset}\n";

	} else {
		echo "{$blue}INFO The website (leave the name empty to skip){$reset}\n";
		$name = askValue('Name');
		if ($name === '') {
			echo "{$yellow}Skipped; set it later in the administration (Settings).{$reset}\n";

		} else {
			// both rows, so the settings form of the administration shows both fields
			$db->query('INSERT IGNORE INTO [settings] %ex', [
				['name' => 'website', 'value' => $name],
				['name' => 'description', 'value' => askValue('Description')],
			]);
			echo "{$green}OK The website name and description are saved.{$reset}\n";
		}
	}
}

exit(0);


/** Asks for a setting, again while it is longer than the column (255 characters). */
function askValue(string $question): string
{
	while (mb_strlen($answer = ask($question)) > 255) {
		echo "\033[31mERROR: At most 255 characters.\033[0m\n";
	}

	return $answer;
}


function ask(string $question): string
{
	echo $question . ': ';
	return trim((string) fgets(STDIN));
}


/** Reads the answer without showing it, where the terminal allows it (stty, not on Windows). */
function askHidden(string $question): string
{
	if (PHP_OS_FAMILY === 'Windows') {
		return ask($question);
	}

	echo $question . ': ';
	shell_exec('stty -echo');
	$answer = trim((string) fgets(STDIN));
	shell_exec('stty echo');
	echo "\n";
	return $answer;
}


/** Returns the configuration file under app/ that registers the extension of the migrations, if any. */
function findMigrationConfig(string $dir): ?string
{
	if (!is_dir($dir)) {
		return null;
	}

	$files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS));
	foreach ($files as $file) {
		if ($file->getExtension() === 'neon' && str_contains((string) file_get_contents($file->getPathname()), 'MigrationExtension')) {
			return $file->getPathname();
		}
	}

	return null;
}


function deleteDir(string $dir): void
{
	if (!is_dir($dir)) {
		return;
	}

	$items = new RecursiveIteratorIterator(
		new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
		RecursiveIteratorIterator::CHILD_FIRST,
	);
	foreach ($items as $item) {
		$item->isDir() ? rmdir($item->getPathname()) : unlink($item->getPathname());
	}

	rmdir($dir);
}
